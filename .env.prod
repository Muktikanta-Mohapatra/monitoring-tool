# Production Environment Configuration
# Copy this file to .env and update all values before deploying to production

# ClickHouse Configuration
CLICKHOUSE_DB=logforwarder
CLICKHOUSE_USER=logforwarder
CLICKHOUSE_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Elasticsearch Configuration
ELASTIC_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# JWT Configuration - MUST be changed in production
JWT_SECRET=CHANGE_THIS_TO_GENERATED_SECRET_KEY_MIN_64_CHARS
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Application Configuration
SPRING_PROFILES_ACTIVE=prod
WEBSOCKET_ORIGINS=https://your-production-domain.com

# Vite UI Configuration
VITE_API_URL=https://your-production-domain.com

# LogForwarder Configuration
LOGFORWARDER_ID=prod-forwarder

# Additional Production Settings
LOG_LEVEL=warn
