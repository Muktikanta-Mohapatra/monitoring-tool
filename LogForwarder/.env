# ================================================================
# LogForwarder Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values
# The .env file will be loaded automatically at startup
# ================================================================

# API Key for authenticating with middleware
# This MUST be the plain-text API key that will be sent in X-API-Key header
# The middleware has the BCrypt hash of this key stored in database
# IMPORTANT: Do NOT put a BCrypt hash here - use the original plain-text key
FORWARDER_API_KEY=forwarder-secret-key-001

# Optional: Override forwarder ID
# If not set, will use the value from inputs.yaml or generate UUID
# FORWARDER_ID=forwarder-001

# Optional: Override middleware URL
# MIDDLEWARE_URL=http://localhost:8080/api/v1/events/batch

# Optional: Log level (trace, debug, info, warn, error)
# RUST_LOG=info

# ================================================================
# SECURITY NOTES:
# ================================================================
# 1. NEVER commit .env file to version control
# 2. Keep .env file permissions restricted (chmod 600 .env)
# 3. Rotate API keys regularly (every 90 days recommended)
# 4. Use different API keys for different environments
# ================================================================
