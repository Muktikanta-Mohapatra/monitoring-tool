# ClickHouse Configuration
# CLICKHOUSE_DB=logforwarder
# CLICKHOUSE_USER=logforwarder
# CLICKHOUSE_PASSWORD=your_clickhouse_password

# Elasticsearch Configuration
# ELASTIC_PASSWORD=your_elasticsearch_password

# Redis Configuration
# REDIS_PASSWORD=your_redis_password

# JWT Configuration
# JWT_SECRET=your_jwt_secret_key_change_this
# JWT_EXPIRATION_MS=86400000
# JWT_REFRESH_EXPIRATION_MS=604800000

# Application Configuration
# SPRING_PROFILES_ACTIVE=dev
# WEBSOCKET_ORIGINS=http://localhost:3000

# Vite UI Configuration
# VITE_API_URL=http://localhost:8080

# LogForwarder Configuration
# LOGFORWARDER_ID=your-forwarder-id
