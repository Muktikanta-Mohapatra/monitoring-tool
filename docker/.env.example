# ==============================================================================
# LOGFORWARDER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize the values for your environment.
#
# For development: Most defaults are suitable, just copy and run
# For production: ALL values marked with CHANGE_THIS must be updated
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up -d
# ==============================================================================

# ==============================================================================
# CLICKHOUSE CONFIGURATION
# ==============================================================================
# ClickHouse is the primary time-series database for log storage
# ==============================================================================

# Database name for LogForwarder data
CLICKHOUSE_DB=logforwarder

# Database user for application connections
CLICKHOUSE_USER=logforwarder

# Database password
# DEVELOPMENT: Default value is fine
# PRODUCTION: CHANGE_THIS to a strong password (min 16 characters)
CLICKHOUSE_PASSWORD=logforwarder

# ==============================================================================
# POSTGRESQL CONFIGURATION
# ==============================================================================
# PostgreSQL is used for transactional data requiring ACID compliance
# ==============================================================================

# Database name
POSTGRESQL_DB=logforwarder

# Database user
POSTGRESQL_USER=logforwarder

# Database password
# DEVELOPMENT: Default value is fine
# PRODUCTION: CHANGE_THIS to a strong password (min 16 characters)
POSTGRESQL_PASSWORD=logforwarder_password

# ==============================================================================
# ELASTICSEARCH CONFIGURATION
# ==============================================================================
# Elasticsearch provides full-text search capabilities
# ==============================================================================

# Elasticsearch user (default superuser)
ELASTICSEARCH_USER=elastic

# Elasticsearch password
# DEVELOPMENT: Default value is fine
# PRODUCTION: CHANGE_THIS to a strong password (min 16 characters)
ELASTIC_PASSWORD=elastic_password

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis is used for caching, sessions, and rate limiting
# ==============================================================================

# Redis password
# DEVELOPMENT: Default value is fine
# PRODUCTION: CHANGE_THIS to a strong password (min 16 characters)
REDIS_PASSWORD=redis_password

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# JSON Web Token configuration for API authentication
# ==============================================================================

# Secret key for signing JWT tokens
# DEVELOPMENT: Default value is fine for local testing
# PRODUCTION: CHANGE_THIS to a cryptographically random string (min 64 characters)
# Generate with: openssl rand -base64 64
JWT_SECRET=dev-insecure-secret-change-in-production

# Access token expiration time in milliseconds
# Default: 86400000 (24 hours) for development
# Production recommendation: 3600000 (1 hour)
JWT_EXPIRATION_MS=86400000

# Refresh token expiration time in milliseconds
# Default: 604800000 (7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
# Spring Boot and general application settings
# ==============================================================================

# Spring profile to activate
# Options: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Allowed origins for WebSocket connections
# Comma-separated list of allowed origins
# DEVELOPMENT: http://localhost:3000
# PRODUCTION: https://your-domain.com
WEBSOCKET_ORIGINS=http://localhost:3000

# ==============================================================================
# UI CONFIGURATION
# ==============================================================================
# Frontend application settings
# ==============================================================================

# Backend API URL for the frontend
# DEVELOPMENT: http://localhost:8080
# PRODUCTION: https://api.your-domain.com or same domain via reverse proxy
VITE_API_URL=http://localhost:8080

# ==============================================================================
# LOGFORWARDER AGENT CONFIGURATION
# ==============================================================================
# Rust log collection agent settings
# ==============================================================================

# Unique identifier for this forwarder instance
# Used to track which forwarder sent which logs
LOGFORWARDER_ID=docker-forwarder

# ==============================================================================
# PRODUCTION-ONLY SETTINGS
# ==============================================================================
# These settings are only used in production mode
# ==============================================================================

# Maximum failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# API rate limit (requests per minute per IP)
API_RATE_LIMIT=1000

# Log level for production
# Options: trace, debug, info, warn, error
LOG_LEVEL=warn

# ==============================================================================
# DOCKER REGISTRY (Production Deployments)
# ==============================================================================
# For pre-built images in production
# ==============================================================================

# Docker registry URL (for production image deployment)
# DOCKER_REGISTRY=your-registry.example.com

# Application version tag
# APP_VERSION=1.0.0
