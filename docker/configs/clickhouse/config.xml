<?xml version="1.0"?>
<!--
================================================================================
CLICKHOUSE SERVER CONFIGURATION
================================================================================
This configuration file defines server-level settings for ClickHouse.
It is mounted to: /etc/clickhouse-server/config.d/config.xml

Key configurations:
- Logging: Log rotation and error logging
- Network: HTTP, TCP, and MySQL wire protocol ports
- Performance: Connection limits, query limits, cache sizes
- Storage: Data paths and temporary storage
- Monitoring: Query log, part log, metric log tables
================================================================================
-->
<clickhouse>
    <!--
    ============================================================================
    LOGGING CONFIGURATION
    ============================================================================
    - level: information (options: trace, debug, information, warning, error)
    - size: Maximum log file size before rotation (1GB)
    - count: Number of rotated log files to keep
    ============================================================================
    -->
    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!--
    ============================================================================
    NETWORK PORTS
    ============================================================================
    - http_port (8123): REST API and web interface
    - tcp_port (9000): Native TCP protocol for clients
    - mysql_port (9004): MySQL wire protocol compatibility
    ============================================================================
    -->
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <mysql_port>9004</mysql_port>

    <!--
    ============================================================================
    LISTEN ADDRESSES
    ============================================================================
    Allow connections from any network interface (required for Docker)
    ============================================================================
    -->
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>

    <!--
    ============================================================================
    CONNECTION AND QUERY LIMITS
    ============================================================================
    - max_connections: Maximum concurrent connections
    - keep_alive_timeout: TCP keep-alive timeout in seconds
    - max_concurrent_queries: Limit concurrent query execution
    ============================================================================
    -->
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>
    <max_concurrent_queries>100</max_concurrent_queries>

    <!--
    ============================================================================
    CACHE SETTINGS
    ============================================================================
    - uncompressed_cache_size: Cache for uncompressed blocks (8GB)
    - mark_cache_size: Cache for index marks (5GB)
    ============================================================================
    -->
    <uncompressed_cache_size>8589934592</uncompressed_cache_size>
    <mark_cache_size>5368709120</mark_cache_size>

    <!--
    ============================================================================
    STORAGE PATHS
    ============================================================================
    - path: Main data storage directory
    - tmp_path: Temporary files during query execution
    - user_files_path: User-uploaded files storage
    ============================================================================
    -->
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>

    <!--
    ============================================================================
    USER CONFIGURATION
    ============================================================================
    -->
    <users_config>users.xml</users_config>
    <default_profile>default</default_profile>
    <default_database>default</default_database>

    <!--
    ============================================================================
    TIMEZONE
    ============================================================================
    Use UTC for consistent timestamp handling across services
    ============================================================================
    -->
    <timezone>UTC</timezone>

    <!--
    ============================================================================
    MEMORY SETTINGS
    ============================================================================
    Lock executable in memory to prevent swapping (improves performance)
    ============================================================================
    -->
    <mlock_executable>true</mlock_executable>

    <!--
    ============================================================================
    DICTIONARY SETTINGS
    ============================================================================
    Reload interval for built-in dictionaries (1 hour)
    ============================================================================
    -->
    <builtin_dictionaries_reload_interval>3600</builtin_dictionaries_reload_interval>

    <!--
    ============================================================================
    SESSION TIMEOUTS
    ============================================================================
    - max_session_timeout: Maximum allowed session duration (1 hour)
    - default_session_timeout: Default session duration (60 seconds)
    ============================================================================
    -->
    <max_session_timeout>3600</max_session_timeout>
    <default_session_timeout>60</default_session_timeout>

    <!--
    ============================================================================
    SYSTEM LOGGING TABLES
    ============================================================================
    Configure logging tables for monitoring and debugging:
    - query_log: Tracks all executed queries
    - part_log: Tracks data part operations
    - metric_log: System metrics collection
    ============================================================================
    -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>

    <part_log>
        <database>system</database>
        <table>part_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>

    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <collect_interval_milliseconds>1000</collect_interval_milliseconds>
    </metric_log>

    <!--
    ============================================================================
    COMPRESSION SETTINGS
    ============================================================================
    Use LZ4 compression for parts larger than 10GB with >1% of total data
    ============================================================================
    -->
    <compression>
        <case>
            <min_part_size>10000000000</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>lz4</method>
        </case>
    </compression>

    <!--
    ============================================================================
    DISTRIBUTED DDL
    ============================================================================
    ZooKeeper path for distributed DDL queries (cluster deployments)
    ============================================================================
    -->
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!--
    ============================================================================
    MERGE TREE SETTINGS
    ============================================================================
    Maximum suspicious broken parts before table becomes read-only
    ============================================================================
    -->
    <merge_tree>
        <max_suspicious_broken_parts>5</max_suspicious_broken_parts>
    </merge_tree>

    <!--
    ============================================================================
    FORMAT SCHEMA PATH
    ============================================================================
    Directory for Protobuf/Cap'n'Proto/Avro schemas
    ============================================================================
    -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>
</clickhouse>
