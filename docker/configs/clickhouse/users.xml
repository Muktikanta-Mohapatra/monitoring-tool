<?xml version="1.0"?>
<!--
================================================================================
CLICKHOUSE USERS CONFIGURATION
================================================================================
This configuration file defines user accounts, profiles, and quotas.
It is mounted to: /etc/clickhouse-server/users.d/users.xml

Security Note:
- Change default passwords in production
- Use environment variables for sensitive credentials
- Consider using LDAP/AD integration for enterprise deployments
================================================================================
-->
<clickhouse>
    <!--
    ============================================================================
    USER PROFILES
    ============================================================================
    Profiles define resource limits and settings for user groups
    ============================================================================
    -->
    <profiles>
        <!--
        Default profile for most users
        - max_memory_usage: 10GB per query
        - load_balancing: random for distributed queries
        -->
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <max_partitions_per_insert_block>1000</max_partitions_per_insert_block>
        </default>

        <!--
        Read-only profile for reporting/analytics users
        -->
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <!--
    ============================================================================
    USER ACCOUNTS
    ============================================================================
    Define user credentials and access permissions
    ============================================================================
    -->
    <users>
        <!--
        Default user (for initial setup and administration)
        WARNING: Change or disable in production!
        -->
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>

        <!--
        Application user for LogForwarder services
        - Limited to logforwarder database only
        - Use environment variable CLICKHOUSE_PASSWORD in production
        -->
        <logforwarder>
            <password>logforwarder</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <allow_databases>
                <database>logforwarder</database>
            </allow_databases>
        </logforwarder>
    </users>

    <!--
    ============================================================================
    QUOTAS
    ============================================================================
    Resource quotas to prevent abuse and ensure fair usage
    - duration: Time window in seconds (3600 = 1 hour)
    - 0 = unlimited
    ============================================================================
    -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
